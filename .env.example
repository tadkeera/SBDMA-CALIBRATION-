# ─────────────────────────────────────────────────────────────
# SBDMA Calibration Platform — environment template
# Copy to .env and replace every CHANGE_ME value before deploying.
# Secrets are NEVER committed; the API refuses to boot without them.
# ─────────────────────────────────────────────────────────────

# --- PostgreSQL 16 ---
POSTGRES_USER=sbdma
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=sbdma_calibration

# --- Application ---
ENVIRONMENT=production
JWT_SECRET=CHANGE_ME_64_char_random_secret
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# --- Scheduled work ---
# "celery" (container: worker + beat) or "vercel-cron" (serverless: vercel.json crons
# call /api/v1/internal/jobs/*). Reported by /worker/status.
SCHEDULER=celery
# Required for the HTTP-scheduled routes; unset means they refuse to run (503).
CRON_SECRET=

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
# One request budget for all API replicas, held in Redis. "redis" makes a broker
# outage a startup error; "auto" silently falls back to one budget per process
# (i.e. N times the configured limit with N replicas).
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=5

# --- CORS (comma separated origins, no wildcards in production) ---
CORS_ORIGINS=https://calibration.sbdma.gov.ye

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=/api/v1

# --- Outbound integrations (optional, per spec section 14) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=calibration@sbdma.gov.ye
SMS_GATEWAY_URL=
SMS_API_KEY=

# --- Storage ---
STORAGE_DRIVER=local
STORAGE_PATH=/srv/storage
MAX_UPLOAD_MB=25

# --- Backups ---
BACKUP_DIR=/srv/backups
BACKUP_RETENTION_DAYS=90

# --- Initial seed credentials (used once by `python -m app.seed`) ---
# If omitted, random passwords are generated and written to
# /tmp/sbdma-seed-credentials.txt (mode 0600). Every seeded account is flagged
# must_change_password = true.
SBDMA_ADMIN_PASSWORD=
SBDMA_QA_MANAGER_PASSWORD=
SBDMA_QA_OFFICER_PASSWORD=
SBDMA_SUPERVISOR_PASSWORD=
SBDMA_REVIEWER_PASSWORD=
SBDMA_ANALYST_PASSWORD=
SBDMA_ANALYST2_PASSWORD=
SBDMA_TECHNICIAN_PASSWORD=
SBDMA_VIEWER_PASSWORD=
